  "components": {
    "schemas": {
      "ActiveIn": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "active"
        ],
        "title": "ActiveIn"
      },
      "ApplianceIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "watts": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Watts"
          },
          "hours_per_day": {
            "type": "number",
            "maximum": 24.0,
            "minimum": 0.0,
            "title": "Hours Per Day"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "name",
          "watts",
          "hours_per_day",
          "quantity"
        ],
        "title": "ApplianceIn"
      },
      "Body_upload_api_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_uploads_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "ReadingIn": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "kwh": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Kwh"
          }
        },
        "type": "object",
        "required": [
          "date",
          "kwh"
        ],
        "title": "ReadingIn"
      },
      "Registration": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "Registration"
      },
      "TariffIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "rate_per_kwh": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Rate Per Kwh"
          },
          "fixed_charge": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Fixed Charge"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "name",
          "rate_per_kwh",
          "fixed_charge",
          "currency"
        ],
        "title": "TariffIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
